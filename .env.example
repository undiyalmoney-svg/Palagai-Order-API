PORT=3000

# Comma-separated allowed browser origins (CORS)
FRONTEND_URLS=https://palagai.app,http://localhost:4200,http://127.0.0.1:4200

# Optional: API_KEY / API_SECRET / ACCESS_TOKEN are NOT required when the
# browser sends Authorization: token {api_key}:{access_token} on each request.
# Keep blanks unless you later move to server-held sessions.
API_KEY=
API_SECRET=
ACCESS_TOKEN=

KITE_API_BASE_URL=https://api.kite.trade

# Auth / P&L (additive) — Atlas free tier. Leave blank for in-memory only.
MONGODB_URI=
MONGODB_DB=palagai
LIVE_AUTH_SECRET=

# Momentum Portfolio Manager
# synthetic (default, simulated data) | kite
MOMENTUM_PROVIDER=synthetic
# Mongo user id whose stored Kite session feeds market data when MOMENTUM_PROVIDER=kite
MOMENTUM_DATA_USER=
# MOMENTUM_DB_PATH=data/momentum/momentum.sqlite
# Encrypts stored broker sessions (defaults to the JWT secret)
MOMENTUM_SECRET=
# Set to 0 to disable the in-process daily/weekly/monthly scheduler
MOMENTUM_SCHEDULER=1
